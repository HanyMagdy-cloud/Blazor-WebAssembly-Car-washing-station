@model CarWashStation.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .dashboard-header {
        background-color: var(--navy);
        color: white;
        padding: 3rem 0;
        margin-top: -3rem; /* Offset container padding if needed */
        margin-bottom: 3rem;
        border-bottom: 4px solid var(--teal);
    }
    .admin-title {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: clamp(2.5rem, 8vw, 4.5rem);
        letter-spacing: -2px;
        line-height: 0.9;
        margin-bottom: 2.5rem;
    }
    .admin-title .text-teal {
        color: var(--teal);
    }
    .stat-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1.25rem;
        padding: 1.5rem;
        transition: transform 0.3s ease, background 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--teal);
    }
    .stat-label {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
    }
    .stat-value {
        font-family: 'Syne', sans-serif;
        font-size: 2.5rem;
        font-weight: 700;
        color: white;
        line-height: 1;
        margin-bottom: 0.5rem;
    }
    .stat-trend {
        font-size: 0.875rem;
        font-weight: 500;
    }
    .trend-up { color: #2ea043; }
    .trend-neutral { color: #f78166; }
    .trend-info { color: #3bbfbf; }
    .trend-alt { color: #58a6ff; }

    .table-container {
        background: white;
        border-radius: 1.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        overflow: hidden;
        margin-top: -1.5rem;
    }
    .search-bar {
        background: white;
        border-radius: 50px;
        padding: 0.5rem 1.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
</style>

<div class="dashboard-header">
    <div class="container">
        <div class="logo-sub-text mb-2" style="color: var(--teal); opacity: 0.8;">ADMINISTRATIONSPANEL</div>
        <h1 class="admin-title">
            Admin <span class="text-teal">Dashboard</span>
        </h1>

        <div class="row g-3">
            <!-- Card 1: Total Bookings -->
            <div class="col-md-3">
                <div class="stat-card">
                    <div>
                        <div class="stat-label">Bokningar Totalt</div>
                        <div class="stat-value">@Model.TotalBookingsCount</div>
                    </div>
                    <div class="stat-trend trend-up">
                        <i class="bi bi-arrow-up"></i> @Model.NewThisWeekCount denna vecka
                    </div>
                </div>
            </div>

            <!-- Card 2: Today -->
            <div class="col-md-3">
                <div class="stat-card">
                    <div>
                        <div class="stat-label">Idag</div>
                        <div class="stat-value">@Model.TodayCount</div>
                    </div>
                    <div class="stat-trend trend-neutral">
                        @Model.RemainingTodayCount kvar
                    </div>
                </div>
            </div>

            <!-- Card 3: Revenue -->
            <div class="col-md-3">
                <div class="stat-card">
                    <div>
                        <div class="stat-label">Intäkter (Mån)</div>
                        <div class="stat-value">@(Model.MonthlyRevenue >= 1000 ? (Model.MonthlyRevenue / 1000).ToString("0.#") + "k" : Model.MonthlyRevenue.ToString("0"))</div>
                    </div>
                    <div class="stat-trend trend-info">
                        kr denna månad
                    </div>
                </div>
            </div>

            <!-- Card 4: Customers -->
            <div class="col-md-3">
                <div class="stat-card">
                    <div>
                        <div class="stat-label">Kunder</div>
                        <div class="stat-value">@Model.TotalCustomersCount</div>
                    </div>
                    <div class="stat-trend trend-alt">
                        @Model.CorporateCustomersCount företag
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <h2 class="h4 fw-bold text-navy m-0">Alla Bokningar</h2>
        
        <form asp-action="Index" method="get" class="d-flex flex-column flex-md-row gap-2 w-100 w-md-auto align-items-md-end">
            <div class="d-flex flex-column flex-sm-row gap-2 flex-grow-1">
                <div class="input-group search-bar" style="min-width: 250px;">
                    <span class="bg-transparent border-0 pe-2 d-flex align-items-center">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchString" class="form-control border-0 bg-transparent shadow-none" 
                           placeholder="Sök företag, namn eller reg-nr..." value="@Model.CurrentFilter">
                </div>
                <div class="input-group search-bar" style="min-width: 180px;">
                    <span class="bg-transparent border-0 pe-2 d-flex align-items-center">
                        <i class="bi bi-calendar-event text-muted"></i>
                    </span>
                    <input type="date" name="filterDate" class="form-control border-0 bg-transparent shadow-none" value="@Model.CurrentDateFilter">
                </div>
            </div>
            <div class="d-flex gap-2 justify-content-end mt-2 mt-md-0">
                <button type="submit" class="btn btn-booking px-4 shadow-sm">Sök</button>
                @if (!string.IsNullOrEmpty(Model.CurrentFilter) || !string.IsNullOrEmpty(Model.CurrentDateFilter))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 d-flex align-items-center">
                        Visa alla
                    </a>
                }
            </div>
        </form>
    </div>

    <div class="table-container border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="py-3 px-4 text-muted small text-uppercase fw-bold">Datum & Tid</th>
                        <th class="py-3 px-4 text-muted small text-uppercase fw-bold">Kund/Företag</th>
                        <th class="py-3 px-4 text-muted small text-uppercase fw-bold">Kontakt</th>
                        <th class="py-3 px-4 text-muted small text-uppercase fw-bold">Bil/Tjänst</th>
                        <th class="py-3 px-4 text-muted small text-uppercase fw-bold">Anteckningar</th>
                        <th class="py-3 px-4 text-muted small text-uppercase fw-bold text-end">Åtgärder</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentBookings.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                                Inga bokningar hittades.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.RecentBookings)
                        {
                            <tr>
                                <td class="px-4">
                                    <div class="fw-bold">@item.BookingDate.ToString("MMM dd, yyyy")</div>
                                    <div class="text-muted small">@item.TimeSlot.ToString(@"hh\:mm")</div>
                                </td>
                                <td class="px-4">
                                    <div class="fw-medium">@item.CustomerName</div>
                                    @if (!string.IsNullOrEmpty(item.CompanyName))
                                    {
                                        <div class="text-teal small"><i class="bi bi-building"></i> @item.CompanyName</div>
                                    }
                                </td>
                                <td class="px-4">
                                    <div>@item.PhoneNumber</div>
                                    <div class="text-muted small">@item.Email</div>
                                </td>
                                <td class="px-4">
                                    <span class="badge bg-navy-light mb-1">@item.CarPlateNumber</span>
                                    <div class="small">@(item.Service?.Name ?? "Okänd")</div>
                                    <div class="text-success small fw-bold">@item.Service?.Price.ToString("N0") kr</div>
                                </td>
                                <td class="px-4">
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <div class="text-muted small" style="max-width: 250px; white-space: normal; word-wrap: break-word;">
                                            @item.Notes
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted opacity-25">-</span>
                                    }
                                </td>
                                <td class="px-4 text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-teal rounded-pill px-3">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Är du säker på att du vill ta bort denna bokning?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .btn-outline-teal {
            color: var(--teal);
            border-color: var(--teal);
        }
        .btn-outline-teal:hover {
            background-color: var(--teal);
            color: white;
        }
        .bg-navy-light {
            background-color: var(--navy-light);
            color: white;
        }
        .text-navy { color: var(--navy); }
    </style>
}
