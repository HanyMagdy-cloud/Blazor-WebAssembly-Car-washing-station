@model IEnumerable<CarWashStation.Models.BlockedSlot>

@{
    ViewData["Title"] = "Schema kontroll";
}

<style>
    .dashboard-header {
        background-color: var(--navy);
        color: white;
        padding: 3rem 0;
        margin-top: -3rem;
        margin-bottom: 3rem;
        border-bottom: 4px solid var(--teal);
    }
    .admin-title {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: clamp(2.5rem, 8vw, 4.5rem);
        letter-spacing: -2px;
        line-height: 0.9;
        margin-bottom: 2.5rem;
    }
    .admin-title .text-teal {
        color: var(--teal);
    }
    .table-container {
        background: white;
        border-radius: 1.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        overflow: hidden;
    }
    .card-custom {
        border-radius: 1.25rem;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }
</style>

<div class="dashboard-header">
    <div class="container">
        <div class="logo-sub-text mb-2" style="color: var(--teal); opacity: 0.8;">ADMINISTRATIONSPANEL</div>
        <h1 class="admin-title">
            Schema <span class="text-teal">kontroll</span>
        </h1>
        <p class="text-muted-light">Här kan du stänga av specifika dagar eller tider för bokning.</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">
        <!-- Form to add new block -->
        <div class="col-lg-4">
            <div class="card card-custom p-4 h-100">
                <h3 class="h5 fw-bold mb-4">Lägg till blockering</h3>
                <form asp-action="BlockSlot" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-bold">Datum</label>
                        <input type="date" name="date" class="form-control rounded-pill px-3" required min="@DateTime.Today.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tid (valfritt)</label>
                        <select name="timeSlot" class="form-select rounded-pill px-3">
                            <option value="">Hela dagen</option>
                            <option value="08:00:00">08:00</option>
                            <option value="08:30:00">08:30</option>
                            <option value="09:00:00">09:00</option>
                            <option value="09:30:00">09:30</option>
                            <option value="10:00:00">10:00</option>
                            <option value="10:30:00">10:30</option>
                            <option value="11:00:00">11:00</option>
                            <option value="11:30:00">11:30</option>
                            <option value="12:00:00">12:00</option>
                            <option value="12:30:00">12:30</option>
                            <option value="13:00:00">13:00</option>
                            <option value="13:30:00">13:30</option>
                            <option value="14:00:00">14:00</option>
                            <option value="14:30:00">14:30</option>
                            <option value="15:00:00">15:00</option>
                            <option value="15:30:00">15:30</option>
                            <option value="16:00:00">16:00</option>
                        </select>
                        <div class="form-text small">Lämna tom för att stänga hela dagen.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Anledning (valfritt)</label>
                        <input type="text" name="reason" class="form-control rounded-pill px-3" placeholder="T.ex. Helgdag">
                    </div>
                    <button type="submit" class="btn btn-booking w-100 rounded-pill py-2 fw-bold">Spara blockering</button>
                </form>
            </div>
        </div>

        <!-- List of existing blocks -->
        <div class="col-lg-8">
            <div class="table-container">
                <div class="p-4 border-bottom bg-light d-flex justify-content-between align-items-center">
                    <h3 class="h5 fw-bold m-0">Aktiva blockeringar</h3>
                    <span class="badge bg-teal-light text-teal-deeper rounded-pill px-3 py-2">@Model.Count() st</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="py-3 px-4 text-muted small text-uppercase fw-bold">Datum</th>
                                <th class="py-3 px-4 text-muted small text-uppercase fw-bold">Omfattning</th>
                                <th class="py-3 px-4 text-muted small text-uppercase fw-bold">Anledning</th>
                                <th class="py-3 px-4 text-muted small text-uppercase fw-bold text-end">Åtgärd</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="bi bi-calendar-check fs-2 d-block mb-2 opacity-50"></i>
                                        Inga tider är blockerade just nu.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="px-4 py-3">
                                            <div class="fw-bold">@item.Date.ToString("ddd, MMM dd, yyyy")</div>
                                        </td>
                                        <td class="px-4 py-3">
                                            @if (item.IsFullDay)
                                            {
                                                <span class="badge bg-danger rounded-pill px-3">Hela dagen</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill px-3">Kl. @item.TimeSlot?.ToString(@"hh\:mm")</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-muted">
                                            @(string.IsNullOrEmpty(item.Reason) ? "-" : item.Reason)
                                        </td>
                                        <td class="px-4 py-3 text-end">
                                            <form asp-action="UnblockSlot" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Vill du ta bort denna blockering?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    <i class="bi bi-trash"></i> Ta bort
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .bg-teal-light { background-color: var(--teal-light); }
        .text-teal-deeper { color: var(--teal-deeper); }
        .btn-booking {
            background: var(--teal);
            border: none;
            color: #fff;
            box-shadow: 0 4px 14px rgba(59,191,191,0.3);
            transition: all 0.2s ease;
        }
        .btn-booking:hover {
            background: var(--teal-dark);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(59,191,191,0.4);
            color: #fff;
        }
        .text-muted-light {
            color: rgba(255,255,255,0.6);
        }
    </style>
}
