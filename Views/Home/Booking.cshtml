@{
    ViewData["Title"] = "Boka tid";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h2 class="fw-bold mb-0">Boka din biltvätt</h2>
                </div>
                <div class="card-body p-3 p-md-5">
                    
                    <!-- Step 1: Date & Time Selection -->
                    <div id="booking-step-1">
                        <h4 class="mb-4 text-primary fw-bold">Steg 1: Välj dag och tid</h4>
                        
                        <div class="mb-4">
                            <label for="bookingDateInput" class="form-label fw-bold">Välj datum</label>
                            <input type="date" class="form-control form-control-lg" id="bookingDateInput" min="@DateTime.Today.ToString("yyyy-MM-dd")">
                        </div>

                        <div id="timeSlotsSection" class="d-none">
                            <label class="form-label fw-bold mb-3">Tillgängliga tider</label>
                            <div class="row g-3" id="timeSlotsGrid">
                                <!-- Time slots injected here via JS -->
                            </div>
                        </div>
                        
                        <div class="text-end mt-4 d-none" id="step1NextBtnContainer">
                            <button type="button" class="btn btn-primary btn-lg rounded-pill px-5" id="btnGoToStep2">Nästa: Dina uppgifter</button>
                        </div>
                    </div>

                    <!-- Step 2: Customer Details -->
                    <div id="booking-step-2" class="d-none">
                        <h4 class="mb-4 text-primary fw-bold">Steg 2: Dina uppgifter</h4>
                        <form id="standaloneBookingForm">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="custName" class="form-label">Namn</label>
                                    <input type="text" class="form-control" id="custName" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="custEmail" class="form-label">E-post</label>
                                    <input type="email" class="form-control" id="custEmail" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="custPhone" class="form-label">Telefonnummer</label>
                                    <input type="tel" class="form-control" id="custPhone" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="carPlateNum" class="form-label">Registreringsnummer</label>
                                    <input type="text" class="form-control" id="carPlateNum" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="firmeName" class="form-label">Företagsnamn (valfritt)</label>
                                    <input type="text" class="form-control" id="firmeName">
                                </div>
                                <div class="col-12">
                                    <label for="servSelect" class="form-label">Välj tjänst</label>
                                    <select class="form-select" id="servSelect" required>
                                        <option value="">Välj en tjänst...</option>
                                        <option value="1">Utvändig tvätt (400 kr)</option>
                                        <option value="2">In & utvändig tvätt (750 kr)</option>
                                        <option value="3">Rekond (fr 2500 kr)</option>
                                        <option value="4">Tvätt + vax (1750 kr)</option>
                                        <option value="5">Motortvätt (350 kr)</option>
                                        <option value="6">Invändig tvätt (400 kr)</option>
                                        <option value="7">Däckförvaring + skifte (950 kr / säsong)</option>
                                        <option value="8">Däckskifte (350 kr)</option>
                                        <option value="9">Lackförsegling (2295 kr)</option>
                                        <option value="10">Laga punktering (350 kr)</option>
                                        <option value="11">Däckmontering (300 kr / däck)</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label for="bookingMsg" class="form-label">Anteckningar (valfritt)</label>
                                    <textarea class="form-control" id="bookingMsg" rows="3"></textarea>
                                </div>
                            </div>
                            
                            <!-- Hidden fields to hold selected Date and Time -->
                            <input type="hidden" id="selectDate">
                            <input type="hidden" id="selectTime">
                            
                            <div class="d-flex justify-content-between mt-5">
                                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" id="btnBackToStep1">Tillbaka</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold" id="btnConfirmBooking">Bekräfta bokning</button>
                            </div>
                        </form>
                    </div>

                    <!-- Step 3: Success Message -->
                    <div id="booking-step-success" class="d-none text-center py-5">
                        <div class="mb-4">
                            <div class="display-1 text-success mb-3">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <h2 class="fw-bold">Bokning är klart</h2>
                        </div>
                        <a asp-action="Index" class="btn btn-primary rounded-pill px-5">Tillbaka till start</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Service loading is now hardcoded in HTML for reliability.


            // Date change event
            $('#bookingDateInput').change(function () {
                var selectedDate = $(this).val();
                if (!selectedDate) return;

                // Client-side validation for past dates
                var today = new Date();
                today.setHours(0, 0, 0, 0);
                var selDate = new Date(selectedDate);
                
                if (selDate < today) {
                    alert('Du kan inte boka ett datum i det förflutna.');
                    $(this).val('');
                    $('#timeSlotsSection').addClass('d-none');
                    return;
                }

                $('#selectDate').val(selectedDate);
                
                $.get('/Booking/GetAvailableSlots', { date: selectedDate }, function (slots) {
                    var $grid = $('#timeSlotsGrid');
                    $grid.empty();
                    
                    if (slots.length === 0) {
                        $grid.append('<div class="col-12 text-center text-muted">Inga tider tillgängliga för detta datum.</div>');
                    } else {
                        slots.forEach(function (slot) {
                            $grid.append('<div class="col-6 col-sm-4 col-md-3">' +
                                '<button type="button" class="btn btn-outline-primary w-100 time-slot-btn" data-time="' + slot + '">' +
                                slot + '</button></div>');
                        });
                    }
                    $('#timeSlotsSection').removeClass('d-none');
                    $('#step1NextBtnContainer').addClass('d-none');
                }).fail(function() {
                    alert('Kunde inte hämta tillgängliga tider. Försök igen senare.');
                });
            });

            // Time slot selection
            $(document).on('click', '.time-slot-btn', function () {
                $('.time-slot-btn').removeClass('active btn-primary').addClass('btn-outline-primary');
                $(this).removeClass('btn-outline-primary').addClass('active btn-primary');
                $('#selectTime').val($(this).data('time'));
                $('#step1NextBtnContainer').removeClass('d-none');
            });

            // Step navigation
            $('#btnGoToStep2').click(function () {
                $('#booking-step-1').addClass('d-none');
                $('#booking-step-2').removeClass('d-none');
                window.scrollTo(0, 0);
            });

            $('#btnBackToStep1').click(function () {
                $('#booking-step-2').addClass('d-none');
                $('#booking-step-1').removeClass('d-none');
            });

            // Form submission
            $('#standaloneBookingForm').submit(function (e) {
                e.preventDefault();
                
                var bookingData = {
                    CustomerName: $('#custName').val(),
                    Email: $('#custEmail').val(),
                    PhoneNumber: $('#custPhone').val(),
                    BookingDate: $('#selectDate').val(),
                    TimeSlot: $('#selectTime').val(),
                    CarPlateNumber: $('#carPlateNum').val(),
                    ServiceId: parseInt($('#servSelect').val()),
                    CompanyName: $('#firmeName').val(),
                    Notes: $('#bookingMsg').val()
                };

                $('#btnConfirmBooking').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Bokar...');

                $.ajax({
                    url: '/Booking/CreateBooking',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(bookingData),
                    success: function (response) {
                        $('#booking-step-2').addClass('d-none');
                        $('#booking-step-success').removeClass('d-none');
                    },
                    error: function (xhr) {
                        alert('Ett fel uppstod: ' + xhr.responseText);
                        $('#btnConfirmBooking').prop('disabled', false).text('Bekräfta bokning');
                    }
                });
            });
        });
    </script>
}
