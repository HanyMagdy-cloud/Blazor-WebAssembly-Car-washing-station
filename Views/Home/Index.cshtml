@{
    ViewData["Title"] = "Hem";
}

<style>
    /* ── Hero Section ── */
    .hero-wrapper {
        position: relative;
        min-height: 92vh;
        margin-top: -1rem;
        border-radius: 0 0 4rem 4rem;
        overflow: hidden;
        background: var(--navy);
    }
    
    .hero-bg {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: linear-gradient(90deg, rgba(13,43,62,1) 0%, rgba(13,43,62,0.85) 30%, rgba(13,43,62,0.4) 60%, transparent 100%), 
                    url('@Url.Content("~/images/home.png")') center/cover no-repeat;
    }

    .hero-container {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        min-height: 92vh;
        padding: 5rem 1.25rem; /* 20px side padding */
    }

    .hero-content-panel {
        max-width: 700px;
        animation: fade-in-left 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes fade-in-left {
        from { opacity: 0; transform: translateX(-50px); }
        to { opacity: 1; transform: translateX(0); }
    }

    .hero-title {
        font-family: 'Raleway', sans-serif;
        font-weight: 900;
        letter-spacing: -3px;
        line-height: 1.05;
        margin-bottom: 2rem;
        color: #fff;
        font-size: clamp(2.5rem, 8vw, 5rem);
    }
    .hero-title span {
        color: var(--teal);
        text-shadow: 0 0 30px rgba(59,191,191,0.4);
    }

    .hero-subtitle {
        font-size: 1.4rem;
        color: rgba(255,255,255,0.9);
        margin-bottom: 4rem;
        line-height: 1.6;
        border-left: 4px solid var(--teal);
        padding-left: 2rem;
    }

    /* ── Features ── */
    .feature-card {
        background: #fff;
        border: none;
        border-radius: 2rem;
        padding: 3rem 2rem;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid var(--border-col);
        height: 100%;
    }
    .feature-card:hover {
        transform: translateY(-12px);
        box-shadow: 0 20px 40px rgba(13, 43, 62, 0.08);
        border-color: var(--teal-mid);
    }
    
    .icon-box {
        width: 80px; height: 80px;
        background: var(--teal-light);
        color: var(--teal-dark);
        border-radius: 1.5rem;
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
    }
    .feature-card:hover .icon-box {
        background: var(--teal);
        color: #fff;
        transform: rotate(-5deg) scale(1.1);
    }

    /* ── Section Headers ── */
    .section-label {
        font-size: 0.85rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--teal-dark);
        margin-bottom: 1rem;
        display: block;
    }
    .section-title {
        font-family: 'Raleway', sans-serif;
        font-weight: 800;
        color: var(--navy);
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }
    .title-accent {
        width: 60px; height: 4px;
        background: var(--teal);
        border-radius: 10px;
        margin-bottom: 3rem;
    }

    /* ── Quick Services (Matching "Våra Tjänster" Design) ── */
    .service-card {
        border: none;
        border-radius: 1.5rem;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(13, 43, 62, 0.05);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        overflow: hidden;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    .service-card:hover {
        transform: translateY(-12px);
        box-shadow: 0 20px 40px rgba(13, 43, 62, 0.12);
        border: 1px solid var(--teal-light);
    }
    .service-img-wrapper {
        height: 220px;
        width: 100%;
        overflow: hidden;
        background: #ffffff;
        position: relative;
        padding: 1.875rem 0 0 0; /* 30px top space */
    }
    .service-img {
        height: 100%;
        width: 100%;
        object-fit: fill;
        transition: transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .service-card:hover .service-img {
        transform: scale(1.1);
    }
    .price-tag {
        font-size: 1.25rem;
        color: var(--teal-dark);
        font-weight: 800;
        margin-bottom: 1rem;
    }
    .btn-boka {
        padding: 0.8rem 2rem;
        font-weight: 800;
        transition: all 0.3s ease;
        background: var(--teal);
        color: #fff !important;
        border: none;
        border-radius: 50px;
    }
    .btn-boka:hover {
        background: var(--navy);
        box-shadow: 0 5px 15px rgba(13,43,62,0.2);
    }

    /* ── Bottom CTA ── */
    .cta-banner {
        background: var(--navy);
        border-radius: 3.5rem;
        padding: 5rem 3rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .cta-banner::before {
        content: '';
        position: absolute;
        top: -50%; right: -20%; width: 400px; height: 400px;
        background: radial-gradient(circle, rgba(59,191,191,0.1) 0%, transparent 70%);
        border-radius: 50%;
    }

    /* ── Buttons ── */
    .btn-premium {
        background: var(--teal);
        color: #fff !important;
        padding: 1.2rem 3.5rem;
        border-radius: 50px;
        font-weight: 800;
        font-size: 1.1rem;
        border: none;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 10px 25px rgba(59,191,191,0.4);
    }
    .btn-premium:hover {
        background: var(--teal-dark);
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(59,191,191,0.5);
    }

    .reveal {
        opacity: 0; transform: translateY(30px);
        transition: all 0.8s ease-out;
    }
    .reveal.active {
        opacity: 1; transform: translateY(0);
    }
</style>

<!-- Hero Section -->
<div class="hero-wrapper">
    <div class="hero-bg"></div>
    <div class="hero-container container">
        <div class="hero-content-panel">
            <span class="badge rounded-pill px-4 py-2 mb-4" 
                  style="background: rgba(59,191,191,0.2); color: var(--teal-mid); border: 1px solid rgba(59,191,191,0.3); font-weight: 800;">
                VÄLKOMMEN TILL ÅRSTA BILVÅRD
            </span>
            <h1 class="hero-title">Professionell<br><span>Bilvård</span> & Handtvätt</h1>
            <p class="hero-subtitle">Ge din bil den behandling den förtjänar. Vi kombinerar noggrann handtvätt med premiumprodukter för ett resultat som glänser varje gång.</p>
            <div class="d-flex flex-column flex-sm-row gap-3">
                <a asp-action="Booking" class="btn btn-premium shadow-lg px-xs-4">Boka din tid nu</a>
                <a asp-action="Services" class="btn btn-outline-light rounded-pill px-4 px-sm-5 fw-bold d-flex align-items-center justify-content-center" style="border-width: 2px;">
                    Se våra tjänster <i class="bi bi-chevron-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Features -->
<div class="container py-5 mt-5">
    <div class="text-center mb-5 reveal">
        <span class="section-label">Varför välja oss?</span>
        <h2 class="section-title">Kvalitet i varje detalj</h2>
        <div class="title-accent mx-auto"></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4 col-md-6 reveal">
            <div class="feature-card">
                <div class="icon-box"><i class="bi bi-water"></i></div>
                <h4 class="fw-bold mb-3" style="color: var(--navy);">Skonsam Handtvätt</h4>
                <p class="text-muted">Vi använder endast mjuka svampar och mikrofiberdukar för att eliminera risken för repor från automatiska borstar.</p>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 reveal">
            <div class="feature-card">
                <div class="icon-box"><i class="bi bi-shield-check"></i></div>
                <h4 class="fw-bold mb-3" style="color: var(--navy);">Premiumprodukter</h4>
                <p class="text-muted">Endast marknadsledande rengörings- och vaxprodukter används för att ge din bil ett långvarigt skydd.</p>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 reveal">
            <div class="feature-card">
                <div class="icon-box"><i class="bi bi-stars"></i></div>
                <h4 class="fw-bold mb-3" style="color: var(--navy);">Erfaret Team</h4>
                <p class="text-muted">Vår personal har stor erfarenhet av alla typer av bilar, från vardagsbilar till exklusiva sportbilar.</p>
            </div>
        </div>
    </div>
</div>

<!-- Service Highlights -->
<div class="container py-5 mt-5">
    <div class="d-flex justify-content-between align-items-end mb-5 reveal">
        <div>
            <span class="section-label">Tjänster</span>
            <h2 class="section-title m-0">Populära val</h2>
        </div>
        <a asp-action="Services" class="btn btn-link text-decoration-none fw-bold p-0" style="color: var(--teal-dark);">Se alla tjänster →</a>
    </div>
    
    <div class="row g-5 justify-content-center">
        <!-- 1. Utvändig tvätt -->
        <div class="col-md-6 col-lg-4 reveal">
            <div class="service-card shadow-sm">
                <div class="service-img-wrapper">
                    <img src="~/images/1.png" alt="Utvändig tvätt" class="service-img" />
                </div>
                <div class="card-body p-4 text-center d-flex flex-column">
                    <h3 class="card-title fw-bold mb-3" style="color: var(--navy);">Utvändig tvätt</h3>
                    <div class="price-tag">400 kr</div>
                    <p class="card-text text-muted mb-4 flex-grow-1 small">Professionell yttre rengöring som tar bort smuts och ger glans.</p>
                    <div class="mt-auto">
                        <a asp-action="Booking" class="btn btn-boka w-100">Boka nu</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. In och utvändig tvätt -->
        <div class="col-md-6 col-lg-4 reveal">
            <div class="service-card shadow-sm">
                <div class="service-img-wrapper">
                    <img src="~/images/2.png" alt="In och utvändig tvätt" class="service-img" />
                </div>
                <div class="card-body p-4 text-center d-flex flex-column">
                    <h3 class="card-title fw-bold mb-3" style="color: var(--navy);">In & utvändig tvätt</h3>
                    <div class="price-tag">750 kr</div>
                    <p class="card-text text-muted mb-4 flex-grow-1 small">Komplett rengöring för både insida och utsida av din bil.</p>
                    <div class="mt-auto">
                        <a asp-action="Booking" class="btn btn-boka w-100">Boka nu</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Rekond -->
        <div class="col-md-6 col-lg-4 reveal">
            <div class="service-card shadow-sm">
                <div class="service-img-wrapper">
                    <img src="~/images/3.png" alt="Rekond" class="service-img" />
                </div>
                <div class="card-body p-4 text-center d-flex flex-column">
                    <h3 class="card-title fw-bold mb-3" style="color: var(--navy);">Rekond</h3>
                    <div class="price-tag">fr 2500 kr</div>
                    <p class="card-text text-muted mb-4 flex-grow-1 small">Djupgående rengöring för att återställa bilens nybilskänsla.</p>
                    <div class="mt-auto">
                        <a asp-action="Booking" class="btn btn-boka w-100">Boka nu</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Call to Action -->
<div class="container py-5 mb-5 mt-5">
    <div class="cta-banner reveal">
        <h2 class="display-5 fw-bold text-white mb-4">Är din bil redo för en uppfräschning?</h2>
        <p class="text-white opacity-75 mb-5 fs-5">Boka en tid direkt online eller kom förbi vår station i Årsta för drop-in.</p>
        <a asp-action="Booking" class="btn btn-premium btn-lg">Säkra din tid idag</a>
    </div>
</div>

@section Scripts {
    <script>
        function reveal() {
            var reveals = document.querySelectorAll(".reveal");
            for (var i = 0; i < reveals.length; i++) {
                var windowHeight = window.innerHeight;
                var elementTop = reveals[i].getBoundingClientRect().top;
                var elementVisible = 150;
                if (elementTop < windowHeight - elementVisible) {
                    reveals[i].classList.add("active");
                }
            }
        }
        window.addEventListener("scroll", reveal);
        // Trigger initial check
        reveal();
    </script>
}
