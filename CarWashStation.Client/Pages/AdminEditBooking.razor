@page "/admin/bookings/{Id:int}/edit"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject CarWashStation.Client.Services.ToastService Toasts
@using CarWashStation.Models

<PageTitle>Redigera bokning</PageTitle>
<section class="edit-page">
    <header><a href="admin">← Tillbaka</a><h1>Redigera <strong>bokning</strong></h1></header>
    @if (unauthorized) { <div class="notice">Du behöver <a href="login">logga in</a>.</div> }
    else if (booking is null) { <div class="notice">Laddar…</div> }
    else
    {
        <div class="edit-card">
            <h2>Bokningsdetaljer</h2>
            <EditForm Model="booking" OnValidSubmit="Save">
                <DataAnnotationsValidator /><ValidationSummary class="validation" />
                <div class="form-grid">
                    <label>KUNDNAMN<InputText @bind-Value="booking.CustomerName" /></label>
                    <label>E-POST<InputText type="email" @bind-Value="booking.Email" /></label>
                    <label>TELEFONNUMMER<InputText @bind-Value="booking.PhoneNumber" /></label>
                    <label>REGISTRERINGSNUMMER<InputText @bind-Value="booking.CarPlateNumber" /></label>
                    <label class="wide">TJÄNST<InputSelect @bind-Value="booking.ServiceId">@foreach (var service in services) { <option value="@service.Id">@service.Name</option> }</InputSelect></label>
                    <label>DATUM<InputDate @bind-Value="booking.BookingDate" /></label>
                    <label>TID<InputText type="time" @bind-Value="timeText" /></label>
                    <label>FÖRETAGSNAMN (VALFRITT)<InputText @bind-Value="booking.CompanyName" /></label>
                    <label class="wide">ANTECKNINGAR (VALFRITT)<InputTextArea @bind-Value="booking.Notes" /></label>
                </div>
                @if (!string.IsNullOrWhiteSpace(error)) { <p class="error">@error</p> }
                <div class="form-actions"><button type="submit" disabled="@saving">@(saving ? "Sparar…" : "Spara ändringar")</button><a href="admin">Avbryt</a></div>
            </EditForm>
        </div>
    }
</section>

@code {
 [Parameter] public int Id { get; set; }
 private CarWashStation.Models.Booking? booking;
 private List<Service> services = [];
 private string timeText = "";
 private string? error;
 private bool saving, unauthorized;
 protected override async Task OnParametersSetAsync()
 {
   var response = await Http.GetAsync($"api/admin/bookings/{Id}");
   unauthorized = response.StatusCode == System.Net.HttpStatusCode.Unauthorized;
   if (!response.IsSuccessStatusCode) return;
   booking = await response.Content.ReadFromJsonAsync<CarWashStation.Models.Booking>();
   services = await Http.GetFromJsonAsync<List<Service>>("api/bookings/services") ?? [];
   timeText = booking?.TimeSlot.ToString(@"hh\:mm") ?? "";
 }
 private async Task Save()
 {
   if (booking is null || !TimeSpan.TryParse(timeText, out var time)) { error = "Ange en giltig tid."; return; }
   booking.TimeSlot = time; booking.Service = null; saving = true; error = null;
   var response = await Http.PutAsJsonAsync($"api/admin/bookings/{booking.Id}", booking);
   saving = false;
   if (response.IsSuccessStatusCode) { Toasts.Success("Bokningen har uppdaterats."); Navigation.NavigateTo("admin"); }
   else { error = await response.Content.ReadAsStringAsync(); Toasts.Error("Ändringarna kunde inte sparas."); }
 }
}
