@page "/booking"
@inject HttpClient Http
@using CarWashStation.Models

<PageTitle>Boka</PageTitle>
<section class="page narrow"><h1>Boka bilvård</h1>
<EditForm Model="booking" OnValidSubmit="Submit"><DataAnnotationsValidator /><ValidationSummary />
    <label>Namn<InputText @bind-Value="booking.CustomerName" /></label>
    <label>E-post<InputText @bind-Value="booking.Email" /></label>
    <label>Telefon<InputText @bind-Value="booking.PhoneNumber" /></label>
    <label>Registreringsnummer<InputText @bind-Value="booking.CarPlateNumber" /></label>
    <label>Företag (valfritt)<InputText @bind-Value="booking.CompanyName" /></label>
    <label>Tjänst<InputSelect @bind-Value="booking.ServiceId"><option value="0">Välj tjänst</option>@foreach (var item in services) { <option value="@item.Id">@item.Name – @item.Price.ToString("0") kr</option> }</InputSelect></label>
    <label>Datum<InputDate @bind-Value="booking.BookingDate" @bind-Value:after="LoadSlots" min="@DateTime.Today.ToString("yyyy-MM-dd")" /></label>
    <label>Tid<select @bind="selectedSlot"><option value="">Välj tid</option>@foreach (var slot in slots) { <option value="@slot">@slot</option> }</select></label>
    <label>Anteckningar<InputTextArea @bind-Value="booking.Notes" /></label>
    <button class="button" disabled="@submitting">@(submitting ? "Skickar…" : "Bekräfta bokning")</button>
</EditForm>
@if (!string.IsNullOrWhiteSpace(message)) { <p class="message">@message</p> }
</section>

@code {
    private CarWashStation.Models.Booking booking = new() { BookingDate = DateTime.Today.AddDays(1) };
    private List<Service> services = [];
    private List<string> slots = [];
    private string selectedSlot = "";
    private string? message;
    private bool submitting;

    protected override async Task OnInitializedAsync()
    {
        services = await Http.GetFromJsonAsync<List<Service>>("api/bookings/services") ?? [];
        await LoadSlots();
    }
    private async Task LoadSlots()
    {
        slots = await Http.GetFromJsonAsync<List<string>>($"api/bookings/available-slots?date={booking.BookingDate:yyyy-MM-dd}") ?? [];
        selectedSlot = "";
    }
    private async Task Submit()
    {
        if (!TimeSpan.TryParse(selectedSlot, out var time)) { message = "Välj en ledig tid."; return; }
        booking.TimeSlot = time; submitting = true; message = null;
        var response = await Http.PostAsJsonAsync("api/bookings", booking);
        message = response.IsSuccessStatusCode ? "Tack! Din bokning är bekräftad." : await response.Content.ReadAsStringAsync();
        submitting = false;
    }
}
